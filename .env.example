# ============================================
# OBSIDIAN BOUNTY FINDER - ENVIRONMENT CONFIG
# ============================================

# ============ DATABASE ============
# SQLite (standalone mode)
DATABASE_URL=sqlite://data/bounties.db

# PostgreSQL (server mode)
# DATABASE_URL=postgres://user:password@localhost:5432/bounties

# ============ APPLICATION ============
# Application mode: "standalone" or "server"
APP_MODE=standalone

# Server configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# JWT secret for API authentication
JWT_SECRET=your-secret-key-change-in-production

# ============ RUST ============
RUST_LOG=info
RUST_BACKTRACE=1

# ============ PLATFORM API KEYS ============
# GitHub (create at: https://github.com/settings/tokens)
GITHUB_TOKEN=
GITHUB_ORGANIZATION=

# Gitcoin (create at: https://gitcoin.co/settings/developer)
GITCOIN_API_KEY=

# HackerOne (create at: https://hackerone.com/settings/api_credentials)
HACKERONE_API_KEY=
HACKERONE_USERNAME=

# Bugcrowd (create at: https://bugcrowd.com/settings/api)
BUGCROWD_API_KEY=
BUGCROWD_USERNAME=

# LaborX (create at: https://laborx.com/settings/api)
LABORX_API_KEY=

# DeWork (create at: https://dework.com/settings/api)
DEWORK_API_KEY=

# ============ NOTIFICATIONS ============
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ============ WALLET CONNECT ============
# Get your project ID at: https://cloud.walletconnect.com
WALLET_CONNECT_PROJECT_ID=

# ============ OPTIONAL SERVICES ============
# Redis for caching/pub-sub
REDIS_URL=redis://localhost:6379

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=obsidian-bounty-finder
